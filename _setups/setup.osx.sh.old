#!/bin/zsh

# Exit script on error
set -e

# Install Conda
echo "Installing Miniconda..."
if [ "$(uname -s)" == "Darwin" ]; then
    curl -o Miniconda3-latest-MacOSX-x86_64.sh https://repo.anaconda.com/miniconda/Miniconda3-latest-MacOSX-x86_64.sh
    chmod +x Miniconda3-latest-MacOSX-x86_64.sh
    ./Miniconda3-latest-MacOSX-x86_64.sh -b -p $HOME/miniconda
    rm Miniconda3-latest-MacOSX-x86_64.sh
    echo "export PATH=\$HOME/miniconda/bin:\$PATH" >> ~/.zshrc
    source ~/.zshrc
else
    echo "Unsupported OS. This script is for macOS."
    exit 1
fi

# Verify Conda installation
conda --version
echo "Miniconda installed successfully."

# Install Git
echo "Installing Git..."
brew install git
git --version
echo "Git installed successfully."

# Generate SSH key
echo "Generating SSH keypair..."
read -p "Enter your email for the SSH key (default: $(whoami)@$(hostname)): " email
email=${email:-$(whoami)@$(hostname)}

ssh-keygen -t rsa -b 4096 -C "$email" -f ~/.ssh/id_rsa -N ""

# Start the SSH agent
eval "$(ssh-agent -s)"
ssh-add ~/.ssh/id_rsa

# Upload SSH key to GitHub
echo "Uploading SSH key to GitHub..."
read -p "Enter your GitHub username: " github_username
read -sp "Enter your GitHub personal access token: " github_token
echo

# Get public key
public_key=$(cat ~/.ssh/id_rsa.pub)

# Create JSON payload
payload=$(cat <<EOF
{
  "title": "My macOS SSH key",
  "key": "$public_key"
}
EOF
)

# Upload key
response=$(curl -s -o /dev/null -w "%{http_code}" -u "$github_username:$github_token" \
  -X POST -H "Accept: application/vnd.github.v3+json" \
  https://api.github.com/user/keys \
  -d "$payload")

if [ "$response" -eq 201 ]; then
    echo "SSH key uploaded successfully to GitHub."
else
    echo "Failed to upload SSH key to GitHub. HTTP response: $response"
    exit 1
fi

# Final message
echo "Environment setup completed successfully!"